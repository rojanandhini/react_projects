datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model News {
  postNo      String   @id @unique @default(uuid())
  postDate    DateTime @default(now())
  title       String
  desc        String
  eligibility String
  salary      String
  impDates    String
  howToApply  String
}

model Users {
  userId      String @id @unique @default(uuid())
  email       String @unique
  firstName   String
  secondName  String
  gender      String
  dateOfBirth String
  password    String
  mobNo       String
}
