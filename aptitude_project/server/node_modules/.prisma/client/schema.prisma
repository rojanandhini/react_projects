datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model News {
  postNo      String   @id @unique @default(uuid())
  postDate    DateTime @default(now())
  title       String
  desc        String
  eligibility String
  salary      String
  impDates    String
  howToApply  String
}

model Users {
  userId      String @id @unique @default(uuid())
  email       String @unique
  firstName   String
  secondName  String
  gender      String
  dateOfBirth String
  password    String
  mobNo       String
}

model testPage {
  testId      Int         @id @unique @default(autoincrement())
  slug        String      @unique
  title       String
  img         String
  description String
  topics      String
  papers      TestPaper[]
}

model TestPaper {
  id              String     @id @default(cuid())
  title           String
  durationMinutes Int
  difficulty      String     @default("Medium")
  questions       Question[]
  createdAt       DateTime   @default(now())
  testPageId      Int
  testPage        testPage   @relation(fields: [testPageId], references: [testId])
}

model Question {
  id           String    @id @default(cuid())
  questionText String    @db.Text
  explanation  String?   @db.Text
  marks        Int       @default(1)
  testPaperId  String
  testPaper    TestPaper @relation(fields: [testPaperId], references: [id])
  options      Option[]
}

model Option {
  id         String   @id @default(cuid())
  text       String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
}
