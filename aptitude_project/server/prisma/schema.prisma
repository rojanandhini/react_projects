datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
  }

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model News {
  postNo String @id @unique @default(uuid())
  postDate DateTime @default(now()) 
  title String
  desc String
  eligibility String
  salary String
  impDates String
  howToApply String
}

model  Users {
  userId String @id @unique @default(uuid())
  email String @unique
  firstName String
  secondName String 
  gender String
  dateOfBirth String
  password String
  mobNo String
  userTest UserTest[]
  userMetrics UserMetrics[]
}

model TestPage {
  testId Int @id @unique @default(autoincrement())
  slug String @unique
  title String
  img String
  description String
  topics String
  papers      TestPaper[]
}

model TestPaper {
  id              String     @id @default(cuid())
  title           String
  durationMinutes Int
  difficulty      String     @default("Medium")
  questions       Question[]
  createdAt       DateTime   @default(now())
  testPageId      Int
  testPage        TestPage @relation(fields: [testPageId], references: [testId])
  testSet TestSet[]
}

model Question {
  id              String    @id @default(cuid())
  questionText    String    @db.Text
  explanation     String?   @db.Text
  marks           Int       @default(1)
  testPaperId     String
  testPaper       TestPaper @relation(fields: [testPaperId], references: [id])
  options         Option[]
}

model Option {
  id         String   @id @default(cuid())
  text       String
  isCorrect  Boolean  @default(false)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
}

model TestSet{
  id Int @id @unique @default(autoincrement())
  questions String[]
  createdAt DateTime   @default(now())
  testPaperId String 
  testPaper TestPaper @relation(fields: [testPaperId],references: [id])
  userTest UserTest[]
}

model UserTest{
  id String @id @unique @default(cuid())
  submittedAt DateTime @default(now())
  testId Int 
  testSet TestSet @relation(fields:[testId],references: [id])
  answers Json
  qnAttempted Boolean @default(false)
  score Int
  correctAnsCount Int
  wrongAnsCount   Int
  unansweredCount Int
  userId String
  users Users @relation(fields: [userId],references: [userId])
}

model UserMetrics{
  id String @id  @default(cuid())
  userId String @unique
  users Users @relation(fields: [userId],references: [userId])
  setsAttempted String[]
  totalCorrect Int @default(0)
  totalIncorrect Int @default(0)
  totalUnanswered Int @default(0)
  review Int
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
